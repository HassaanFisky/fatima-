# ==============================================================================
# ATELIER PERSONALIZED DIGITAL EXPERIENCE ENGINE - ENVIRONMENT VARIABLES
# ==============================================================================

# --- AI INFERENCE ENGINES ---
# Primary AI Engine (Ultra-fast Cerebras Qwen 3.8 27B: 150,000 TPM limit)
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Secondary Fallback AI Engine (Groq Qwen 3.8 27B)
GROQ_API_KEY=your_groq_api_key_here

# Optional AI Fallback Engine (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Model Override (Defaults to qwen-3.8-27b on Cerebras)
PORTRAIT_MODEL=qwen-3.8-27b

# --- SECURITY & AUTHENTICATION ---
# HMAC Session Secret for signing ownership cookies
ATELIER_SESSION_SECRET=atelier-epistemic-engine-default-hmac-key-2026

# --- PLATFORM INTEGRATIONS (OPTIONAL) ---
# Vercel Deployment Token (for in-app 1-click edge deployments)
VERCEL_TOKEN=your_vercel_token_here

# GitHub Token (for publishing experiences directly to repository)
GITHUB_TOKEN=your_github_token_here

# --- REMOTE STORAGE (OPTIONAL) ---
# Supabase PostgreSQL backend (Defaults to local file storage: data/experiences.json)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
